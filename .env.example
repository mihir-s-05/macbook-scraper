# Hard deal filter
MAX_PRICE=1200
MIN_MEMORY_GB=24
MIN_STORAGE_GB=1024
ALLOWED_CHIPS=M4,M5

# Docker/VPS mode: poll every 5 minutes. The app enforces a 60-second minimum.
POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=25

# Docker/VPS mode: persist dedupe/reappearance state on a mounted volume.
STATE_PATH=/data/state.json
REALERT_AFTER_HOURS=6

# ntfy push notifications.
# Use a long, unguessable topic name if you use public ntfy.sh.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Optional: set a Bearer token if you use a reserved/protected ntfy topic.
NTFY_TOKEN=

# Optional Best Buy developer API key. HTML monitoring works without one.
BESTBUY_API_KEY=

# Amazon HTML scraping is disabled by default for the AWS Lambda deployment
# because Amazon currently returns HTTP 503 to the AWS egress requests.
# Set true only if you intentionally want to retry Amazon from this runtime.
ENABLE_AMAZON=false

# Lambda source-health alerts. A degraded source alerts after three bad scans,
# then at most once every six hours until it recovers.
SOURCE_ALERT_AFTER=3
SOURCE_REALERT_HOURS=6

# AWS Lambda mode only. `sam deploy` sets this automatically from template.yaml.
DYNAMODB_TABLE=

# Optional. Railway/Fly may inject PORT automatically; 0 disables health HTTP.
PORT=0

# Docker/VPS only: set true for cron-style platforms; false for an always-on container.
RUN_ONCE=false
LOG_LEVEL=INFO
