# Hard deal filter
MAX_PRICE=1200
MIN_MEMORY_GB=24
MIN_STORAGE_GB=1024
ALLOWED_CHIPS=M4,M5

# Poll every 5 minutes. The app enforces a 60-second minimum.
POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=25

# Persist dedupe/reappearance state on a mounted volume.
STATE_PATH=/data/state.json
REALERT_AFTER_HOURS=6

# Create a Discord webhook in the channel where you want deal alerts.
DISCORD_WEBHOOK_URL=

# Optional. Railway/Fly may inject PORT automatically; 0 disables health HTTP.
PORT=0

# Set true for cron-style platforms; leave false for an always-on container.
RUN_ONCE=false
LOG_LEVEL=INFO
